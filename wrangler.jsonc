  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/_build/crew.json"],
