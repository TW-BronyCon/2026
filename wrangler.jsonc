      "binding": "CREW_SNAPSHOT",
      "id": "6fc2088966e04fa380ad769162148bc8",
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "DISCORD_BOT_TOKEN",
      "store_id": "04b2d9d449e343e1a66606d6675ce2b2",
      "secret_name": "DISCORD_BOT_TOKEN",
    },
    {
      "binding": "DISCORD_GUILD_ID",
      "store_id": "04b2d9d449e343e1a66606d6675ce2b2",
      "secret_name": "DISCORD_GUILD_ID",
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
}
